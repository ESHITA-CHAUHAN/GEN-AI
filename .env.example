# No OpenAI key is needed when running through this linked Netlify project.
# Netlify AI Gateway supplies the provider configuration automatically.
# These are optional if you run the app outside Netlify and bring your own provider.
# OPENAI_API_KEY=your-provider-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
